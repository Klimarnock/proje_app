<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBackFromAddActivity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="BACK TO DASHBOARD"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="ADD ACTIVITY"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#252525"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVITY TYPE"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_dark"
            android:padding="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvRunning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏃\nRUNNING"
                android:textColor="#39FF5A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSwimming"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏊\nSWIMMING"
                android:textColor="#777777"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCycling"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🚴\nCYCLING"
                android:textColor="#777777"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATE"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="October 26, 2023"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DURATION"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDuration"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="45"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTANCE"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDistance"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="7.85 km"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALORIES BURNED"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="542 kcal"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVERAGE SPEED"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAvgSpeed"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="10.3 km/h"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnSaveActivity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SAVE ACTIVITY"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#101010"
            android:backgroundTint="#16C8FF" />

    </LinearLayout>

</ScrollView>